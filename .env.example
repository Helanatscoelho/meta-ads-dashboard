# ─── Meta Ads Credentials ──────────────────────────────────────────────
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA faça commit do arquivo .env no Git.
#
# Como gerar o token:
#   1. Acesse: https://developers.facebook.com/tools/explorer/
#   2. Selecione seu app (ou crie um em developers.facebook.com)
#   3. Clique em "Generate Access Token"
#   4. Escopos necessários:
#        ads_read
#        ads_management
#        business_management
#        read_insights
#   5. Para token de longa duração (60 dias):
#        GET /oauth/access_token?grant_type=fb_exchange_token&...
#        (documentação: developers.facebook.com/docs/facebook-login/guides/access-tokens/get-long-lived)
#
# Para produção, use um System User Token via:
#   Meta Business Manager > Configurações > Usuários do sistema

META_ACCESS_TOKEN=cole_seu_token_aqui
